#version 450
/* Batch 3^3 max dilation of raw occupancy, including each updated block's
 * one-texel halo. The lowest covering workgroup owns each output texel so
 * adjacent blocks never race while refreshing their shared border. */
layout(local_size_x = 64) in;

layout(binding = 0) uniform sampler3D occ_raw;
layout(binding = 1, r8) uniform writeonly image3D occ_out;

layout(std430,binding=2) readonly buffer Slots { uint data[]; } slots;
layout(push_constant) uniform PC { uint abpa, bpa, offset; } pc;
ivec3 origin(uint i) {
  uint b = slots.data[pc.offset+i*2+1];
  return max(ivec3(b%pc.bpa,(b/pc.bpa)%pc.bpa,b/(pc.bpa*pc.bpa))*2-1,ivec3(0));
}
void main() {
  uint id = gl_LocalInvocationID.x;
  ivec3 c = origin(gl_WorkGroupID.x)+ivec3(id%4,(id/4)%4,id/16);
  int d = int(pc.bpa*2);
  if (any(greaterThanEqual(c,ivec3(d)))) return;
  // Adjacent updated blocks share halo texels. Assign each overlapping
  // output to the first group covering it; no concurrent image writes.
  for(uint i=0;i<gl_WorkGroupID.x;i++) {
    ivec3 q = c-origin(i);
    if(all(greaterThanEqual(q,ivec3(0))) && all(lessThan(q,ivec3(4)))) return;
  }
  float m = 0.0;
  for (int dz = -1; dz <= 1; dz++)
    for (int dy = -1; dy <= 1; dy++)
      for (int dx = -1; dx <= 1; dx++) {
        ivec3 q = clamp(c + ivec3(dx, dy, dz), ivec3(0), ivec3(d - 1));
        m = max(m, texelFetch(occ_raw, q, 0).r);
      }
  imageStore(occ_out, c, vec4(m));
}
