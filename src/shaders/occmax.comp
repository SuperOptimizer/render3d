#version 450
/* Max-reduce the brick atlas into an 8^3-block occupancy texture indexed in
 * WORLD space (one thread per occupancy texel). Slot geometry: 132^3 slots
 * with a 2-voxel apron; identity world<->slot mapping (v1 full residency).
 * Runs once after the atlas fill. */
layout(local_size_x = 64) in;

layout(binding = 0) uniform sampler3D atlas;
layout(binding = 1, r8) uniform writeonly image3D occ;

layout(push_constant) uniform PC { uint odim; } pc; /* world blocks per axis */

const int SLOT = 128;
const int AP = 0;

void main() {
  uint id = gl_GlobalInvocationID.x;
  uint n = pc.odim * pc.odim * pc.odim;
  if (id >= n) return;
  ivec3 ob = ivec3(int(id % pc.odim), int((id / pc.odim) % pc.odim),
                   int(id / (pc.odim * pc.odim)));
  ivec3 brick = ob >> 4;              /* 16 blocks per brick per axis */
  ivec3 lb = (ob & 15) * 8;           /* block origin within the brick */
  ivec3 base = brick * SLOT + AP + lb;
  float m = 0.0;
  for (int dz = 0; dz < 8; dz++)
    for (int dy = 0; dy < 8; dy++)
      for (int dx = 0; dx < 8; dx++)
        m = max(m, texelFetch(atlas, base + ivec3(dx, dy, dz), 0).r);
  imageStore(occ, ob, vec4(m));
}
