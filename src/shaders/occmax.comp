#version 450
/* Max-reduce each updated 16^3 atlas block to 2^3 world occupancy texels.
 * One dispatch covers the batch; each workgroup consumes one slot/world ID
 * pair from the upload staging buffer. */
layout(local_size_x = 64) in;

layout(binding = 0) uniform sampler3D atlas;
layout(binding = 1, r8) uniform writeonly image3D occ;

layout(std430,binding=2) readonly buffer Slots { uint data[]; } slots;
layout(push_constant) uniform PC { uint abpa, bpa, offset; } pc;

void main() {
  uint id = gl_LocalInvocationID.x;
  uint s = slots.data[pc.offset + gl_WorkGroupID.x*2];
  uint b = slots.data[pc.offset + gl_WorkGroupID.x*2+1];
  ivec3 so = ivec3(s%pc.abpa,(s/pc.abpa)%pc.abpa,s/(pc.abpa*pc.abpa))*16;
  ivec3 wo = ivec3(b%pc.bpa,(b/pc.bpa)%pc.bpa,b/(pc.bpa*pc.bpa))*2;
  if (id >= 8u) return;
  ivec3 lb = ivec3(int(id & 1u), int((id >> 1u) & 1u), int(id >> 2u));
  ivec3 base = so + lb * 8;
  float m = 0.0;
  for (int dz = 0; dz < 8; dz++)
    for (int dy = 0; dy < 8; dy++)
      for (int dx = 0; dx < 8; dx++)
        m = max(m, texelFetch(atlas, base + ivec3(dx, dy, dz), 0).r);
  imageStore(occ, wo + lb, vec4(m));
}
