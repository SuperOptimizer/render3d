#version 450
/* Max-reduce one brick's atlas slot into the WORLD-indexed raw occupancy
 * (8^3 voxels per occupancy texel, 16^3 texels per brick). Region form: one
 * dispatch per brick with its slot/world origins pushed, so streaming mode
 * can update occupancy incrementally as bricks decode; identity mode loops
 * the same kernel over every brick. */
layout(local_size_x = 64) in;

layout(binding = 0) uniform sampler3D atlas;
layout(binding = 1, r8) uniform writeonly image3D occ;

layout(push_constant) uniform PC {
  uint sx, sy, sz; /* atlas texel origin of the slot payload */
  uint wx, wy, wz; /* world 8^3-block origin of the brick (brick coord * 16) */
} pc;

void main() {
  uint id = gl_GlobalInvocationID.x;
  if (id >= 16u * 16u * 16u) return;
  ivec3 lb = ivec3(int(id & 15u), int((id >> 4u) & 15u), int(id >> 8u));
  ivec3 base = ivec3(int(pc.sx), int(pc.sy), int(pc.sz)) + lb * 8;
  float m = 0.0;
  for (int dz = 0; dz < 8; dz++)
    for (int dy = 0; dy < 8; dy++)
      for (int dx = 0; dx < 8; dx++)
        m = max(m, texelFetch(atlas, base + ivec3(dx, dy, dz), 0).r);
  imageStore(occ, ivec3(int(pc.wx), int(pc.wy), int(pc.wz)) + lb, vec4(m));
}
